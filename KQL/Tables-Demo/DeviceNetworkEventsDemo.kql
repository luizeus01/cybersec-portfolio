let urls = dynamic(["www.bing.com", "www.hotmail.com", "www.login.microsoftonline.com", "www.microsoft.com", "www.office.com", "outlook.office.com", "teams.microsoft.com", "portal.azure.com", "github.com", "www.youtube.com"]);
let users = dynamic(["john.smith", "sarah.johnson", "michael.brown", "emily.davis", "david.wilson", "olivia.taylor", "daniel.anderson", "sophia.thomas", "james.jackson", "emma.white"]);
let devices = dynamic(["SOC-LAPTOP-01", "CLOUD-ADMIN-02", "FINANCE-WS-03", "HR-LAPTOP-04", "IT-SUPPORT-05", "SALES-LAPTOP-06", "DEV-WORKSTATION-07", "EXECUTIVE-WS-08", "MARKETING-09", "OPERATIONS-10"]);
let DeviceNetworkEventsDemo = range EventIndex from 0 to 99 step 1
| extend UserIndex = (EventIndex * 3 + 1) % array_length(users), DeviceIndex = (EventIndex * 7 + toint(EventIndex / 10)) % array_length(devices), UrlIndex = (EventIndex * 9 + toint(EventIndex / 6)) % array_length(urls), TimeGenerated = datetime(2026-08-22 21:24:30) + EventIndex * 5m
| extend Timestamp = TimeGenerated, DeviceId = strcat("demo-device-", DeviceIndex + 1), DeviceName = tostring(devices[DeviceIndex]), ActionType = "ConnectionSuccess", InitiatingProcessAccountDomain = "azuread", InitiatingProcessAccountName = tostring(users[UserIndex]), InitiatingProcessAccountUpn = strcat(tostring(users[UserIndex]), "@test-demo.com"), InitiatingProcessFileName = "msedge.exe", InitiatingProcessFolderPath = @"c:\program files (x86)\microsoft\edge\application\msedge.exe", InitiatingProcessCommandLine = @'"msedge.exe" --type=utility --utility-sub-type=network.mojom.NetworkService', InitiatingProcessParentFileName = "msedge.exe", InitiatingProcessIntegrityLevel = "Medium", LocalIP = strcat("192.168.153.", 30 + DeviceIndex), LocalIPType = "Private", LocalPort = 58508 + EventIndex, Protocol = "Tcp", RemoteIP = "52.123.242.8", RemoteIPType = "Public", RemotePort = 443, RemoteUrl = tostring(urls[UrlIndex]), ReportId = 87315 + EventIndex, InitiatingProcessSessionId = 7, IsInitiatingProcessRemoteSession = false, Type = "DeviceNetworkEvents"
| project-away EventIndex, UserIndex, DeviceIndex, UrlIndex;
DeviceNetworkEventsDemo