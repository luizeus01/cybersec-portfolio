// Used to simulate a user with lots signins
let JohnSigninLogs = range LogNumber from 1 to 30 step 1
| extend TimeGenerated = datetime(2026-07-01 08:00:00) + (LogNumber - 1) * 1d + (LogNumber % 5) * 17m, UserPrincipalName = "john.smith@test-demo.com", Location = iff(LogNumber <= 24, "GB", "US"), IPAddress = iff(LogNumber <= 24, strcat("51.140.22.", tostring(40 + LogNumber)), strcat("20.84.16.", tostring(40 + LogNumber))), AutonomousSystemNumber = iff(LogNumber <= 24, 8075, 8075), DeviceName = iff(LogNumber <= 24, "JOINEDTEST000", "JOINEDTEST001")
| extend ResultType = 0, ResultSignature = "SUCCESS", ResultDescription = "Success", DeviceDetail = bag_pack("displayName", DeviceName, "operatingSystem", "Windows 11", "deviceId", "DEV001", "trustType", "Microsoft Entra joined"), MfaDetail = dynamic({"authMethod":"Microsoft Authenticator"}), AuthenticationRequirement = "multiFactorAuthentication", ConditionalAccessPolicies = dynamic([{"displayName":"Require MFA","result":"success"},{"displayName":"Require Compliant Device","result":"success"}]), ConditionalAccessStatus = "success", AppDisplayName = iff(LogNumber % 2 == 0, "Microsoft Teams", "Office 365 Exchange Online"), ClientAppUsed = "Browser", UserAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/149.0.0.0 Safari/537.36 Edg/149.0.0.0", RiskLevelAggregated = "none", RiskLevelDuringSignIn = "none", RiskState = "none", RiskEventTypes = dynamic([]), CorrelationId = strcat("john-correlation-", format_datetime(TimeGenerated, "yyyyMMdd")), SessionId = strcat("john-session-", format_datetime(TimeGenerated, "yyyyMMdd"))
| extend ResourceDisplayName = iff(LogNumber % 2 == 0, "Microsoft Teams", "Office 365 Exchange Online")
| project-away LogNumber, DeviceName;
let SarahSigninLogs = range LogNumber from 1 to 30 step 1
| extend TimeGenerated = datetime(2026-07-01 09:00:00) + (LogNumber - 1) * 1d + (LogNumber % 6) * 13m, UserPrincipalName = "sarah.johnson@test-demo.com", Location = iff(LogNumber <= 24, "BR", "IT"), IPAddress = iff(LogNumber <= 24, strcat("177.93.120.", tostring(60 + LogNumber)), strcat("151.12.44.", tostring(60 + LogNumber))), AutonomousSystemNumber = iff(LogNumber <= 24, 28573, 3269), DeviceName = iff(LogNumber <= 24, "JOINEDTEST002", "JOINEDTEST003")
| extend ResultType = 0, ResultSignature = "SUCCESS", ResultDescription = "Success", DeviceDetail = bag_pack("displayName", DeviceName, "operatingSystem", "Windows 11", "deviceId", "DEV002", "trustType", "Microsoft Entra joined"), MfaDetail = dynamic({"authMethod":"Windows Hello for Business"}), AuthenticationRequirement = "multiFactorAuthentication", ConditionalAccessPolicies = dynamic([{"displayName":"Require MFA","result":"success"},{"displayName":"Require Compliant Device","result":"success"}]), ConditionalAccessStatus = "success", AppDisplayName = iff(LogNumber % 2 == 0, "Azure Portal", "Microsoft Defender XDR"), ClientAppUsed = "Browser", UserAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/149.0.0.0 Safari/537.36 Edg/149.0.0.0", RiskLevelAggregated = "none", RiskLevelDuringSignIn = "none", RiskState = "none", RiskEventTypes = dynamic([]), CorrelationId = strcat("sarah-correlation-", format_datetime(TimeGenerated, "yyyyMMdd")), SessionId = strcat("sarah-session-", format_datetime(TimeGenerated, "yyyyMMdd"))
| extend ResourceDisplayName = iff(LogNumber % 2 == 0, "Azure Portal", "Microsoft Defender XDR")
| project-away LogNumber, DeviceName;
let SigninLogsDemo = union JohnSigninLogs, SarahSigninLogs;
SigninLogsDemo